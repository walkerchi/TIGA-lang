@LIT_SITE_CFG_IN_HEADER@

import os
import lit.llvm

lit.llvm.initialize(lit_config, config)

config.tiga_src_root = r"@CMAKE_SOURCE_DIR@"
config.tiga_obj_root = r"@CMAKE_BINARY_DIR@"
config.tiga_tools_dir = r"@LLVM_RUNTIME_OUTPUT_INTDIR@"
config.llvm_tools_dir = r"@TIGA_LLVM_TEST_TOOLS_DIR@"

lit_config.load_config(
    config, os.path.join(config.tiga_src_root, "tests", "lit.cfg.py")
)
